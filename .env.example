# FarmDirect Environment Configuration Template
# Copy this file to .env and configure values when connecting to backend services.

# Application
VITE_APP_NAME="FarmDirect"
VITE_APP_ENV="development"
VITE_APP_URL="http://localhost:5173"

# Backend API Endpoint (For future backend integration)
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Feature Flags
VITE_ENABLE_MOCK_DATA="true"
VITE_ENABLE_AI_ASSISTANT="true"
